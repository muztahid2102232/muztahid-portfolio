# Public base URL of the deployed site. Used for canonical URLs, Open Graph, and sitemap generation.
# In local development, defaults to http://localhost:3000. In production, set to your custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub integration (used for the GitHub Activity section).
# Set your GitHub username here or directly in src/data/social-links.ts.
GITHUB_USERNAME=muztahid2102232

# Optional: Personal Access Token (classic with public_repo read or fine-grained).
# Increases GitHub API rate limits from 60 req/hr to 5,000 req/hr.
# Never prefix with NEXT_PUBLIC_ to keep it private on the server.
GITHUB_TOKEN=

# Resend Email Configuration (used for the Contact form).
# Obtain your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact submissions will be delivered.
CONTACT_EMAIL=your-email@example.com

# Verified sender email in Resend.
# For testing with Resend's default domain, you can use: Portfolio Contact <onboarding@resend.dev>
# For custom domain in production, use a verified address (e.g., Portfolio Contact <contact@yourdomain.com>).
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
